# Build artefacts
*.o
*.mod
*.smod
*.mexa64
*.mexmaca64

# ifx -gen-interfaces output
*__genmod.f90

# Run outputs from the sensitivity templates (regenerate via the
# run_*.m drivers).  The PNGs from verifyall.m ARE checked in as the
# canonical visual reference for users; only the heavy .mat outputs
# are skipped.
templates/50_sensitivities/**/*.mat

# Large derived binary products (>= ~20 MB): NOT committed -- a small
# committed <file>.fp.json fingerprint (jac_fingerprint) stands in as the
# reviewable truth, and each consuming README documents the one command
# that rebuilds the .mat from committed inputs.  NO LFS (public repo,
# clone-and-run users).  Explicit paths (not a blanket *.mat) so small
# reviewed artifacts -- presets, the ~6 MB s6_compare.mat, s1-s3/s7
# stage .mat, reports, .in -- stay tracked.
templates/80_end_to_end/e2e/s4_jacobians.mat
templates/80_end_to_end/e2e/e2e_pie_met.mat
templates/30_instruments/bench_ctb/ctb_phase_export_N1024.mat
templates/30_instruments/bench_ctb/ctb_dm_jacobian_N*.mat
# tagged EFC run states (vortex/relin arcs): regenerate in minutes from
# the drivers; the committed truth is the figures + STATUS numbers.
# (the untagged ctb_efc.mat stays committed -- the slide-9 baseline)
templates/30_instruments/bench_ctb/ctb_efc_*.mat
templates/30_instruments/bench_ctb/ctb_pol_screens.mat
# vector-vortex run states (regen lines: CTB_PROP_STATUS SESSION 14)
templates/30_instruments/bench_ctb/ctb_vvc_*.mat
templates/30_instruments/bench_ctb/ctb_study*.mat
# flat DM seed grids (MB-scale zero matrices): ctb_dm_rx rewrites them
# whenever absent, and an absent GridFile on a zero-base DM is benign
templates/30_instruments/bench_ctb/flat*.txt
templates/80_end_to_end/e2e6m/s4_sens.mat
templates/80_end_to_end/e2e6m_r2/r3_sens.mat
templates/80_end_to_end/e2e6m_r2/r3_dmjac.mat
templates/80_end_to_end/e2e6m_r2/r3_met.mat
