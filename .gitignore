# Build artifacts
*.o
*.mod
*.mexa64
*.mexa64.dSYM/
*.mexmaca64
*.mexmaca64.dSYM/
.fc_stamp

# Per-developer Claude Code local config (permission rules, etc.)
.claude/settings.local.json

# CMake build trees
build_*/
build_debug/
build_release/

# Fortran runtime scratch
fort.*

# SegMirMaker run artifacts (keep test_in/*.in inputs tracked).
# EXCEPT the four tSegMirMaker byte-identity references un-ignored below:
# the class calls them "the committed reference", so they have to actually
# be committed.  While they were ignored the two comparison tests errored
# on every clean worktree, and passed only where someone had run the
# generator by hand -- against a local artifact of unknown provenance.
segmirmaker/test_in/SegMirMaker
segmirmaker/test_in/*.presc
!segmirmaker/test_in/e5pie.presc
!segmirmaker/test_in/e5hex2.presc
segmirmaker/test_in/*Hx.m
!segmirmaker/test_in/e5pieHx.m
!segmirmaker/test_in/e5hex2Hx.m

# Matlab autosave + output caches
*.asv
GMI/test_ff/*.mat

# Runtime binaries and resources copied into test_ff for convenience
GMI/test_ff/libpgplot.so
GMI/test_ff/grfont.dat

# macOS metadata
.DS_Store

# Large per-wavelength broadband result arrays (>100 MB each); keep
# rendered PNGs only.  These are regenerated by run_broadband_*.py.
#
# 2026-07-27: broadened from *.npz to the whole cycle trees + the other
# pymacos/tests artifact sinks after a `git add -A pymacos/tests` swept
# 740 MiB of untracked .npy/.txt artifacts into a commit (caught only
# because the push stalled; see mmacos/CLAUDE.md "git add -A payload
# hazard").  The handful of DELIBERATELY tracked evidence files in these
# trees (cycle5 PNGs, sensitivities .npz/.png) are unaffected -- ignore
# rules never apply to already-tracked files.  New evidence there needs
# an explicit `git add -f <file>`, which is the point.
pymacos/tests/proper_compare/results_cycle*/
pymacos/tests/sensitivities/**/*.png
pymacos/tests/sensitivities/**/*.npz
IntLog.txt

# mmacos PROPER-comparison artefacts (regenerated by `make unittest`).
# Keep the results/ directory tracked via .gitkeep so the harness can
# write into it on a fresh checkout; ignore the rendered artefacts.
mmacos/tests/proper_compare/results/**/*.png
mmacos/tests/proper_compare/results/**/*.mat
mmacos/tests/proper_compare/results/phase*/
# Sweep-guard: bulky untracked working material that must never ride a
# broad `git add` (same hazard class as the pymacos/tests entry above).
mmacos/templates/80_end_to_end/e2e.zip
*.zip
